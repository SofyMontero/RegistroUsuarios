<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PluginBiometrico</AssemblyName>
    <RootNamespace>PluginBiometrico.App</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyTitle>Plugin Biométrico</AssemblyTitle>
    <Product>Plugin Biométrico .NET</Product>
    <Company>Registro Usuarios</Company>
    <Description>Agente de escritorio para lector Digital Persona</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Publicación: solo ensamblados de idioma español -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PluginBiometrico.Core\PluginBiometrico.Core.csproj" />
    <ProjectReference Include="..\PluginBiometrico.Infraestructura\PluginBiometrico.Infraestructura.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Recursos\tryicon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DigitalPersona.NET" Version="1.4.0" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="CopyDigitalPersonaRuntime" AfterTargets="Build">
    <ItemGroup>
      <DpfpRuntime Include="$(PkgDigitalPersona_NET)\lib\net46\DPFPShrNET.dll" />
      <DpfpRuntime Include="$(PkgDigitalPersona_NET)\lib\net46\DPFPDevNET.dll" />
      <DpfpRuntime Include="$(PkgDigitalPersona_NET)\lib\net46\DPFPEngNET.dll" />
      <DpfpRuntime Include="$(PkgDigitalPersona_NET)\lib\net46\DPFPVerNET.dll" />
      <DpfpRuntime Include="$(PkgDigitalPersona_NET)\lib\net46\DPFPGuiNET.dll" />
      <DpfpRuntime Include="$(PkgDigitalPersona_NET)\lib\net46\DPFPCtlXWrapperNET.dll" />
      <DpfpRuntime Include="$(PkgDigitalPersona_NET)\lib\net46\DPFPCtlXTypeLibNET.dll" />
      <DpfpRuntime Include="$(PkgDigitalPersona_NET)\lib\net46\DPFPShrXTypeLibNET.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DpfpRuntime)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(PkgDigitalPersona_NET)\lib\net46\DPFPEngNET.dll')" />
  </Target>

  <!-- Fallback manual si existen en Librerias/ -->
  <ItemGroup Condition="Exists('..\..\Librerias\DPFPEngNET.dll')">
    <None Include="..\..\Librerias\DPFPShrNET.dll" CopyToOutputDirectory="PreserveNewest" Link="DPFPShrNET.dll" />
    <None Include="..\..\Librerias\DPFPDevNET.dll" CopyToOutputDirectory="PreserveNewest" Link="DPFPDevNET.dll" />
    <None Include="..\..\Librerias\DPFPEngNET.dll" CopyToOutputDirectory="PreserveNewest" Link="DPFPEngNET.dll" />
    <None Include="..\..\Librerias\DPFPVerNET.dll" CopyToOutputDirectory="PreserveNewest" Link="DPFPVerNET.dll" Condition="Exists('..\..\Librerias\DPFPVerNET.dll')" />
  </ItemGroup>

</Project>
