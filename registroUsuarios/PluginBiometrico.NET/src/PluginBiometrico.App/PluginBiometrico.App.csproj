<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>PluginBiometrico</AssemblyName>
    <RootNamespace>PluginBiometrico.App</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyTitle>Plugin Biométrico</AssemblyTitle>
    <Product>Plugin Biométrico .NET</Product>
    <Company>Registro Usuarios</Company>
    <Description>Agente de escritorio para lector Digital Persona</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Publicación: solo ensamblados de idioma español -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PluginBiometrico.Core\PluginBiometrico.Core.csproj" />
    <ProjectReference Include="..\PluginBiometrico.Infraestructura\PluginBiometrico.Infraestructura.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Recursos\tryicon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
