<Window x:Class="PluginBiometrico.App.Ventanas.VentanaConfiguracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración | Plugin Biométrico"
        Height="420"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Configuración del sensor biométrico"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#222832"
                   Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="URL habilitar sensor" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2"
                 x:Name="TxtUrlHabilitarSensor"
                 Height="32"
                 Margin="0,0,0,12"
                 ToolTip="Ejemplo: http://localhost/registroUsuarios/Model/HabilitarSensor.php"/>

        <TextBlock Grid.Row="3" Text="URL API REST de huellas" Margin="0,0,0,4"/>
        <TextBox Grid.Row="4"
                 x:Name="TxtUrlApiRest"
                 Height="32"
                 Margin="0,0,0,12"
                 ToolTip="Ejemplo: http://localhost/registroUsuarios/Model/UsuarioRestApi.php"/>

        <StackPanel Grid.Row="5">
            <TextBlock Text="ID único de esta PC (token)" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtIdUnicoPc"
                         Height="32"
                         Margin="0,0,0,12"
                         ToolTip="Debe coincidir con el token que usa la aplicación web"/>

            <TextBlock Text="Navegador" Margin="0,0,0,4"/>
            <ComboBox x:Name="CboNavegador"
                      Height="32"
                      Margin="0,0,0,12"
                      SelectedIndex="0">
                <ComboBoxItem Content="Chrome"/>
                <ComboBoxItem Content="Mozilla"/>
                <ComboBoxItem Content="Edge"/>
                <ComboBoxItem Content="Explorer"/>
            </ComboBox>

            <TextBlock x:Name="TxtMensaje"
                       Foreground="#C0392B"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancelar"
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="BtnCancelar_Click"/>
            <Button Content="Guardar"
                    Width="100"
                    Height="32"
                    Background="#222832"
                    Foreground="White"
                    Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
