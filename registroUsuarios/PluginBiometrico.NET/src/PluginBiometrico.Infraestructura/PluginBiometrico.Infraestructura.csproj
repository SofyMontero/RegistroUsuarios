<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <RutaLibreriasSdk>$(MSBuildThisFileDirectory)..\..\Librerias\</RutaLibreriasSdk>
    <!-- SDK vía NuGet (DigitalPersona.NET) o DLL manuales en Librerias/ -->
    <TieneSdkDpfp Condition="Exists('$(RutaLibreriasSdk)DPFPEngNET.dll')">true</TieneSdkDpfp>
    <TieneSdkDpfp Condition="'$(TieneSdkDpfp)' == ''">true</TieneSdkDpfp>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TieneSdkDpfp)' == 'true'">
    <DefineConstants>$(DefineConstants);TIENE_SDK_DPFP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PluginBiometrico.Core\PluginBiometrico.Core.csproj" />
  </ItemGroup>

  <!-- Fallback manual si NuGet no está disponible y hay DLL en Librerias/ -->
  <ItemGroup Condition="Exists('$(RutaLibreriasSdk)DPFPEngNET.dll')">
    <Reference Include="DPFPShrNET">
      <HintPath>$(RutaLibreriasSdk)DPFPShrNET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DPFPDevNET">
      <HintPath>$(RutaLibreriasSdk)DPFPDevNET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DPFPEngNET">
      <HintPath>$(RutaLibreriasSdk)DPFPEngNET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DPFPVerNET" Condition="Exists('$(RutaLibreriasSdk)DPFPVerNET.dll')">
      <HintPath>$(RutaLibreriasSdk)DPFPVerNET.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DigitalPersona.NET" Version="1.4.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>

</Project>
