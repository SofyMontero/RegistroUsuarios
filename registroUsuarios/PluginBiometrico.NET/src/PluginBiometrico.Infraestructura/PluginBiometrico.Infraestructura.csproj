<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x86</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup>
    <RutaLibreriasSdk>$(MSBuildThisFileDirectory)..\..\Librerias\</RutaLibreriasSdk>
    <TieneSdkDpfpActiveX Condition="Exists('$(RutaLibreriasSdk)DPFPEngXLib.dll')">true</TieneSdkDpfpActiveX>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TieneSdkDpfpActiveX)' == 'true'">
    <DefineConstants>$(DefineConstants);TIENE_SDK_DPFP_ACTIVEX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PluginBiometrico.Core\PluginBiometrico.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TieneSdkDpfpActiveX)' == 'true'">
    <Reference Include="DPFPCtlXLib">
      <HintPath>$(RutaLibreriasSdk)DPFPCtlXLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DPFPDevXLib">
      <HintPath>$(RutaLibreriasSdk)DPFPDevXLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DPFPEngXLib">
      <HintPath>$(RutaLibreriasSdk)DPFPEngXLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DPFPShrXLib">
      <HintPath>$(RutaLibreriasSdk)DPFPShrXLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(RutaLibreriasSdk)DPFPCtlX.dll" Link="DPFPCtlX.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RutaLibreriasSdk)DPFPCtlXLib.dll" Link="DPFPCtlXLib.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RutaLibreriasSdk)DPFPDevX.dll" Link="DPFPDevX.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RutaLibreriasSdk)DPFPEngX.dll" Link="DPFPEngX.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RutaLibreriasSdk)DPFPShrX.dll" Link="DPFPShrX.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>

</Project>
